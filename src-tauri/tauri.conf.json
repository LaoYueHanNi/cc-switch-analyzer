{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CC-Switch Analyzer",
  "version": "0.7.46",
  "identifier": "com.cc-switch-analyzer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:tauri-frontend",
    "beforeBuildCommand": "pnpm build:tauri-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "CC-Switch Analyzer",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://github.com/LaoYueHanNi/cc-switch-analyzer/releases https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LaoYueHanNi/cc-switch-analyzer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0QjMzM0ExODMwQzg1QkMKUldTOGhReURvVE96MU5HTU5EQWFIVkNYdHczQjN3MU15NWFMOHJkUDZTR1Y4K0hDZWpQaU9jbVEK"
    }
  }
}
