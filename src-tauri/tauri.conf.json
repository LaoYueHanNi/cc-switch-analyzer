{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CC-Switch Analyzer",
  "version": "0.0.2",
  "identifier": "com.cc-switch-analyzer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:tauri-frontend",
    "beforeBuildCommand": "pnpm build:tauri-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "CC-Switch Analyzer",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
